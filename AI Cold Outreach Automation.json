      "id": "6b5354d5-0555-494a-ba2b-c17f526d8cde",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        624,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // 1. Extract the email body text from the AI Agent output\n  let raw = item.json.output || item.json.Body || item.json.text || item.json.message?.content || item.json.response || item.json;\n  if (typeof raw === 'object' && raw !== null) {\n    raw = raw.Body || raw.text || raw.content || raw.message || JSON.stringify(raw);\n  }\n  let text = String(raw || \"\");\n\n  // 2. Normalize escaped newlines to real newlines\n  text = text.replace(/\\\\n/g, '\\n');\n\n  // 3. Collapse 3+ consecutive newlines into one clean paragraph break\n  text = text.replace(/\\n{3,}/g, '\\n\\n').trim();\n\n  // 4. Convert markdown links [label](url) to anchors (before bold)\n  text = text.replace(/\\[([^\\]]+)\\]\\((https?:\\/\\/[^)]+)\\)/g, '<a href=\"$2\">$1</a>');\n\n  // 5. Convert markdown bold **text** to <strong> BEFORE touching bullets\n  text = text.replace(/\\*\\*([^*]+?)\\*\\*/g, '<strong>$1</strong>');\n\n  // 6. Normalize any bullet marker (*, -, •) at line start to one clean bullet\n  text = text.split('\\n').map(line => line.replace(/^\\s*[\\*\\-•]\\s+/, '• ')).join('\\n');\n\n  // 7. Convert newlines to HTML breaks: paragraph gaps first, then single breaks\n  let body = text.replace(/\\n\\n/g, '<br><br>').replace(/\\n/g, '<br>');\n\n  // 8. Guard against residual stacked breaks\n  body = body.replace(/(?:<br>\\s*){3,}/g, '<br><br>');\n\n  // 9. Output formatted HTML string\n  item.json.formattedHtml = `<div style=\"font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #222222;\">${body}</div>`;\n}\n\nreturn $input.all();"
      },
